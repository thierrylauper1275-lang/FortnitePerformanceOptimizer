<UserControl x:Class="FortnitePerformanceOptimizer.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20">
            <TextBlock Text="Before/After Performance Benchmark" FontSize="20" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,15" />
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="START BEFORE BENCHMARK" Command="{Binding StartBenchmarkCommand}" Style="{StaticResource ButtonStyle}" Background="#4caf50" />
                <Button Content="BENCHMARK AFTER" Command="{Binding StartAfterBenchmarkCommand}" Style="{StaticResource ButtonStyle}" Background="#2196f3" />
                <Button Content="STOP" Command="{Binding StopBenchmarkCommand}" Style="{StaticResource ButtonStyle}" Background="#f44336" />
                <Button Content="CLEAR" Command="{Binding ClearResultsCommand}" Style="{StaticResource ButtonStyle}" Background="#757575" />
            </StackPanel>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Duration:" Foreground="#ffffff" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider Grid.Column="1" Minimum="10" Maximum="120" Value="{Binding BenchmarkDurationSeconds}" TickFrequency="10" TickPlacement="BottomRight" />
            </Grid>

            <TextBlock Text="{Binding BenchmarkPhaseText}" Foreground="#a0a0a0" Margin="0,0,0,10" />
            <ProgressBar Height="8" Maximum="100" Value="{Binding BenchmarkProgress}" Background="#404040" Foreground="#2196f3" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20">
                <!-- Before Results -->
                <GroupBox Header="BEFORE Optimization" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding BeforeResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="#a0a0a0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#ff9800" FontWeight="Bold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- After Results -->
                <GroupBox Header="AFTER Optimization" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15" Visibility="{Binding AfterResults.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding AfterResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="#a0a0a0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#4caf50" FontWeight="Bold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- Comparison Results -->
                <GroupBox Header="Performance Comparison" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15" Visibility="{Binding BenchmarkComparison, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SummaryText}" Foreground="#4caf50" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,20" />
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="10">
                                <TextBlock Text="FPS" Foreground="#a0a0a0" FontSize="12" />
                                <TextBlock Text="{Binding BenchmarkComparison.FpsImprovement, StringFormat='{0:+0.00;-0.00;0.00}%'}" Foreground="#4caf50" FontSize="16" FontWeight="Bold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10">
                                <TextBlock Text="1% Low" Foreground="#a0a0a0" FontSize="12" />
                                <TextBlock Text="{Binding BenchmarkComparison.Fps1PercentImprovement, StringFormat='{0:+0.00;-0.00;0.00}%'}" Foreground="#4caf50" FontSize="16" FontWeight="Bold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10">
                                <TextBlock Text="Frametime" Foreground="#a0a0a0" FontSize="12" />
                                <TextBlock Text="{Binding BenchmarkComparison.FrametimeImprovement, StringFormat='{0:+0.00;-0.00;0.00}%'}" Foreground="#4caf50" FontSize="16" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
