<UserControl x:Class="FortnitePerformanceOptimizer.Views.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20">
            <TextBlock Text="System Optimization" FontSize="20" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,15" />
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="Profile:" Foreground="#ffffff" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile}" Width="200" Padding="10,5" Background="#404040" Foreground="#ffffff" />
                <Button Content="SCAN OPTIMIZATIONS" Command="{Binding ScanOptimizationsCommand}" Style="{StaticResource ButtonStyle}" Margin="15,0,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="APPLY" Command="{Binding ApplyOptimizationsCommand}" Style="{StaticResource ButtonStyle}" Background="#4caf50" />
                <Button Content="UNDO ALL" Command="{Binding RestoreBackupCommand}" Style="{StaticResource ButtonStyle}" Background="#f44336" IsEnabled="{Binding CanRestoreBackup}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#a0a0a0" />
            <ProgressBar Height="8" Maximum="100" Value="{Binding OptimizationProgress}" Background="#404040" Foreground="#2196f3" Margin="0,10,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20">
                <!-- Available Optimizations -->
                <GroupBox Header="Available Optimizations" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15">
                    <ItemsControl ItemsSource="{Binding AvailableOptimizations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#404040" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsApplied}" VerticalAlignment="Top" Margin="0,5,15,0" Foreground="#ffffff" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#ffffff" />
                                            <TextBlock Text="{Binding Description}" Foreground="#a0a0a0" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ImpactDescription}" Foreground="#808080" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Foreground="#4caf50" FontSize="11" Margin="0,3,0,0">
                                                <Run Text="Expected improvement: " />
                                                <Run Text="{Binding ExpectedFpsImprovementPercent, StringFormat='{0:F1}%'}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="#2196f3" FontSize="11" VerticalAlignment="Top" Margin="10,5,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- Applied Changes Log -->
                <GroupBox Header="Changes Log" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15" Visibility="{Binding AppliedChanges.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ListBox ItemsSource="{Binding AppliedChanges}" Background="#1a1a1a" Foreground="#a0a0a0" Height="150" Padding="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
