<UserControl x:Class="FortnitePerformanceOptimizer.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20">
            <TextBlock Text="Network Performance Testing" FontSize="20" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,15" />
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="MEASURE NETWORK" Command="{Binding MeasureNetworkCommand}" Style="{StaticResource ButtonStyle}" Background="#2196f3" />
                <Button Content="STOP" Command="{Binding StopMeasurementCommand}" Style="{StaticResource ButtonStyle}" Background="#f44336" />
            </StackPanel>

            <TextBlock Text="{Binding NetworkStatusText}" Foreground="#a0a0a0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20">
                <TextBlock Text="⚠️ IMPORTANT" Foreground="#ff9800" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" />
                <TextBlock Foreground="#a0a0a0" TextWrapping="Wrap" Margin="0,0,0,20">
                    This tool measures your Internet connection latency (ping to public DNS servers).
                    This is NOT the same as your Fortnite server ping.
                    For accurate Fortnite server latency, check in-game statistics.
                </TextBlock>

                <!-- Network Metrics -->
                <GroupBox Header="Network Metrics" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="10">
                            <TextBlock Style="{StaticResource TextBlockLabelStyle}" Text="Average Ping" />
                            <TextBlock Style="{StaticResource TextBlockValueStyle}" Text="{Binding AvgPingMs, StringFormat='{0:F1} ms'}" />
                            <TextBlock Foreground="#a0a0a0" FontSize="11" Text="{Binding MinPingMs, StringFormat='Min: {0:F0} ms'}" />
                            <TextBlock Foreground="#a0a0a0" FontSize="11" Text="{Binding MaxPingMs, StringFormat='Max: {0:F0} ms'}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10">
                            <TextBlock Style="{StaticResource TextBlockLabelStyle}" Text="Jitter" />
                            <TextBlock Style="{StaticResource TextBlockValueStyle}" Text="{Binding JitterMs, StringFormat='{0:F2} ms'}" />
                            <TextBlock Foreground="#a0a0a0" FontSize="11" Text="(Latency variation)" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="10">
                            <TextBlock Style="{StaticResource TextBlockLabelStyle}" Text="Packet Loss" />
                            <TextBlock Style="{StaticResource TextBlockValueStyle}" Text="{Binding PacketLossPercent, StringFormat='{0:F2}%'}" />
                            <TextBlock Foreground="#a0a0a0" FontSize="11" Text="(Lost packets)" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Network Quality Assessment -->
                <GroupBox Header="Network Quality" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,10">
                            <Run Text="Status: " />
                            <Run Text="{Binding NetworkStatusText}" Foreground="#4caf50" />
                        </TextBlock>
                        
                        <TextBlock Foreground="#a0a0a0" TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="Ping Guide:" FontWeight="Bold" />
                            <LineBreak />
                            <Run Text="&lt; 50ms: Excellent" Foreground="#4caf50" />
                            <LineBreak />
                            <Run Text="50-100ms: Good" Foreground="#8bc34a" />
                            <LineBreak />
                            <Run Text="100-150ms: Fair" Foreground="#ff9800" />
                            <LineBreak />
                            <Run Text="&gt; 150ms: Poor" Foreground="#f44336" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
