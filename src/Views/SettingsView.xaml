<UserControl x:Class="FortnitePerformanceOptimizer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20">
            <TextBlock Text="Settings & Logs" FontSize="20" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,20" />

            <!-- Settings -->
            <GroupBox Header="Application Settings" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <CheckBox IsChecked="{Binding AutoStartMonitoring}" Foreground="#ffffff" Margin="0,8">
                        <TextBlock Text="Auto-start performance monitoring" Foreground="#ffffff" />
                    </CheckBox>
                    
                    <CheckBox IsChecked="{Binding AutoDetectFortnite}" Foreground="#ffffff" Margin="0,8">
                        <TextBlock Text="Auto-detect Fortnite process" Foreground="#ffffff" />
                    </CheckBox>
                    
                    <CheckBox IsChecked="{Binding ShowDetailedLogs}" Foreground="#ffffff" Margin="0,8">
                        <TextBlock Text="Show detailed debug logs" Foreground="#ffffff" />
                    </CheckBox>

                    <StackPanel Margin="0,15,0,0">
                        <TextBlock Text="Default Benchmark Duration (seconds):" Foreground="#a0a0a0" Margin="0,0,0,8" />
                        <Slider Minimum="10" Maximum="120" Value="{Binding BenchmarkDurationDefault}" TickFrequency="10" TickPlacement="BottomRight" />
                        <TextBlock Text="{Binding BenchmarkDurationDefault, StringFormat='Selected: {0}s'}" Foreground="#a0a0a0" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Log Actions -->
            <GroupBox Header="Logs" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="OPEN LOGS FOLDER" Command="{Binding ExportLogsCommand}" Style="{StaticResource ButtonStyle}" Background="#2196f3" />
                        <Button Content="CLEAR IN-MEMORY LOGS" Command="{Binding ClearLogsCommand}" Style="{StaticResource ButtonStyle}" Background="#f44336" />
                    </StackPanel>
                    
                    <TextBlock Foreground="#a0a0a0" FontSize="11" TextWrapping="Wrap">
                        <Run Text="Logs are saved to: " />
                        <Run Text="%APPDATA%\FortnitePerformanceOptimizer\logs\" Foreground="#2196f3" />
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- Recent Application Logs -->
            <GroupBox Header="Recent Logs" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15">
                <ListBox ItemsSource="{Binding ApplicationLogs}" Background="#1a1a1a" Foreground="#a0a0a0" Height="300" Padding="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="[" Foreground="#606060" />
                                    <Run Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Foreground="#606060" />
                                    <Run Text="]" Foreground="#606060" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Message}" Foreground="#a0a0a0" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- About Section -->
            <GroupBox Header="About" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Fortnite Performance Optimizer" FontSize="16" FontWeight="Bold" Foreground="#ffffff" />
                    <TextBlock Text="v1.0.0" Foreground="#a0a0a0" Margin="0,5,0,0" />
                    <TextBlock Text="Professional Windows Desktop Application" Foreground="#a0a0a0" Margin="0,10,0,0" />
                    
                    <TextBlock Foreground="#a0a0a0" TextWrapping="Wrap" Margin="0,15,0,0" FontSize="11">
                        This application provides real-time performance monitoring, benchmarking, and safe system optimizations for Fortnite gaming.
                        All changes are automatically backed up and can be restored at any time.
                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
