<UserControl x:Class="FortnitePerformanceOptimizer.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e1e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20">
            <TextBlock Text="System Information & Performance Score" FontSize="20" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,15" />
            <Button Content="SCAN PC" Command="{Binding ScanPcCommand}" Style="{StaticResource ButtonStyle}" Width="150" HorizontalAlignment="Left" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20">
                <!-- System Info Display -->
                <GroupBox Header="Detected Hardware" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Margin="10">
                            <TextBlock Style="{StaticResource TextBlockLabelStyle}" Text="CPU" />
                            <TextBlock Style="{StaticResource TextBlockValueStyle}" Text="{Binding SystemInfo.CpuName}" />
                            <TextBlock Foreground="#a0a0a0" Text="{Binding SystemInfo.CpuCoreCount, StringFormat='Cores: {0}'}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Style="{StaticResource TextBlockLabelStyle}" Text="GPU" />
                            <TextBlock Style="{StaticResource TextBlockValueStyle}" Text="{Binding SystemInfo.GpuName}" />
                            <TextBlock Foreground="#a0a0a0" Text="{Binding SystemInfo.NvidiaDriverVersion, StringFormat='Driver: {0}'}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Style="{StaticResource TextBlockLabelStyle}" Text="RAM" />
                            <TextBlock Style="{StaticResource TextBlockValueStyle}" Text="{Binding SystemInfo.TotalRamMb, Converter={StaticResource MBToGBConverter}}" />
                        </StackPanel>

                        <StackPanel Margin="10">
                            <TextBlock Style="{StaticResource TextBlockLabelStyle}" Text="Operating System" />
                            <TextBlock Style="{StaticResource TextBlockValueStyle}" Text="{Binding SystemInfo.WindowsVersion}" />
                            <TextBlock Foreground="#a0a0a0" Text="{Binding SystemInfo.WindowsBuild, StringFormat='Build: {0}'}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Performance Score -->
                <GroupBox Header="Performance Score" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Gaming Score" FontSize="16" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,5" />
                        <TextBlock Style="{StaticResource TextBlockValueStyle}" Text="{Binding OverallScore, StringFormat='{0} / 100'}" Foreground="#4caf50" FontSize="32" />
                        <ProgressBar Height="10" Maximum="100" Value="{Binding OverallScore}" Background="#404040" Foreground="#4caf50" Margin="0,10,0,20" />
                    </StackPanel>
                </GroupBox>

                <!-- Scan Results -->
                <GroupBox Header="Scan Results" Foreground="#ffffff" Background="#252525" Padding="15" Margin="0,0,0,15" Visibility="{Binding ScanResults.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <ListBox ItemsSource="{Binding ScanResults}" Background="#1a1a1a" Foreground="#a0a0a0" Height="200" Padding="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
