<Window x:Class="FortnitePerformanceOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Performance Optimizer"
        Width="1200" Height="800"
        Background="#1e1e1e"
        Foreground="#ffffff"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1e1e1e">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#0d47a1" Padding="20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎮" FontSize="28" Margin="0,0,10,0" />
                <TextBlock Text="Fortnite Performance Optimizer" FontSize="24" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Navigation and Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <StackPanel Grid.Column="0" Background="#252525" Padding="10">
                <Button x:Name="DashboardBtn" Content="📊 Dashboard" Style="{StaticResource ButtonStyle}" Click="OnDashboardClick" Width="130" HorizontalAlignment="Left" />
                <Button x:Name="SystemBtn" Content="🖥️ System" Style="{StaticResource ButtonStyle}" Click="OnSystemClick" Width="130" HorizontalAlignment="Left" />
                <Button x:Name="BenchmarkBtn" Content="📈 Benchmark" Style="{StaticResource ButtonStyle}" Click="OnBenchmarkClick" Width="130" HorizontalAlignment="Left" />
                <Button x:Name="OptimizerBtn" Content="⚙️ Optimizer" Style="{StaticResource ButtonStyle}" Click="OnOptimizerClick" Width="130" HorizontalAlignment="Left" />
                <Button x:Name="NetworkBtn" Content="🌐 Network" Style="{StaticResource ButtonStyle}" Click="OnNetworkClick" Width="130" HorizontalAlignment="Left" />
                <Button x:Name="SettingsBtn" Content="⚡ Settings" Style="{StaticResource ButtonStyle}" Click="OnSettingsClick" Width="130" HorizontalAlignment="Left" />
                <Separator Margin="0,20" Background="#404040" />
                <Button Content="❌ Exit" Click="OnExit" Width="130" HorizontalAlignment="Left" Style="{StaticResource ButtonStyle}" Background="#d32f2f" />
            </StackPanel>

            <!-- Main Content Area -->
            <ContentControl x:Name="MainContent" Grid.Column="1" Background="#1e1e1e" Padding="20" />
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Background="#252525" Padding="15" BorderThickness="0,1,0,0" BorderBrush="#404040">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#a0a0a0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="VersionText" Text="v1.0.0" Foreground="#606060" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
